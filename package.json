{
    "description":  "Sync DeepSeek web conversations into a local Markdown knowledge base through a controlled browser, and publish new DIY projects to GitHub.",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "name":  "dsh-deepseek-hub",
    "version":  "0.1.0",
    "private":  false,
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "deepseek",
                     "deepseek-hub"
                 ],
    "homepage":  "https://github.com/YYY-DXS/dsh-deepseek-hub#readme",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/YYY-DXS/dsh-deepseek-hub.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/YYY-DXS/dsh-deepseek-hub/issues"
             },
    "engines":  {
                    "node":  ">=18",
                    "dsh":  ">=0.1.0-rc.6 <0.3.0-0"
                },
    "files":  [
                  "index.js",
                  "cordis.patch.yml",
                  "scripts/hub-sync.mjs",
                  "scripts/mini-ws.mjs",
                  "scripts/build-jsonl.mjs",
                  "desktop/HubPanel.ps1",
                  "desktop/Launcher.cs",
                  "desktop/DeepSeekHubPanel.exe",
                  "desktop/app.ico",
                  "desktop/启动面板.cmd",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ]
}